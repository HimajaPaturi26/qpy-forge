# API process. Copy to .env only on a machine that runs uvicorn. Do not commit .env.
Q2PY_DB=data/q2py.sqlite
Q2PY_CORPUS=corpus/cases.json
# Optional. Not executed. Status reports oracle-unavailable when this is unset and q is not on PATH.
Q2PY_Q_BIN=
# Comma-separated browser origins, or * .
Q2PY_CORS_ORIGINS=*
